# =============================================================================
# NEPTIQ — .gitignore
#
# Principle: the repository contains SOURCES and PINNED INPUTS only. Anything a
# build, test or export step can regenerate is ignored, because a committed
# artefact silently diverges from the source that produced it and then someone
# trusts the stale copy (P8, reproducibility).
# =============================================================================

# --- Environment / secrets ---------------------------------------------------
# Broad first, then a single explicit exception. .env.example is the ONLY env
# file that may ever be committed, and it carries placeholders only.
.env
.env.*
!.env.example
.dev.vars

# --- Python ------------------------------------------------------------------
__pycache__/
*.pyc
*.py[cod]
*$py.class
.venv/
venv/
.uv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
.tox/
.nox/

# --- Node / Next.js ----------------------------------------------------------
node_modules/
.next/
out/
next-env.d.ts
# Incremental TypeScript build state. Machine-specific absolute paths and
# compiler-version-coupled; regenerated by `tsc` / `next build`.
*.tsbuildinfo
.eslintcache

# --- Generic build output ----------------------------------------------------
dist/
build/

# --- NEPTIQ brand: generated raster/ico output only --------------------------
# The SVG masters in brand/ are the single source of truth and ARE committed.
# Regenerate this directory any time with `make brand`.
apps/web/public/brand/*.png
apps/web/public/brand/*.ico
apps/web/public/brand/*.webp
apps/web/public/brand/*.jpg
apps/web/public/brand/*.svg

# --- Logs --------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editors / OS ------------------------------------------------------------
.yarn/
!.yarn/releases
.vscode/*
!.vscode/launch.json
!.vscode/*.code-snippets
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/shelf
.DS_Store
Thumbs.db
