# =============================================================================
# NEPTIQ — environment template
#
# Copy to .env.local (git-ignored) and fill in. PLACEHOLDER VALUES ONLY in this
# file: it is committed, so a real credential here is a disclosed credential.
#
# Covers every variable in ARCHITECTURE.md §7. Field names, types and defaults
# are authoritative in packages/neptiq_core/src/neptiq_core/settings.py, which
# splits them into:
#   ZoneUSettings  — what an UNTRUSTED worker (fetcher/renderer/parser) may see
#   Settings       — the trusted superset (adds DB, secrets, storage)
# Zone U is deliberately starved: it has no DATABASE_URL and no secrets. Do not
# "helpfully" hand a Zone U container the full env file (ARCHITECTURE §1).
#
# Production domain is NOT yet purchased. Dev uses neptiq.localhost.
# No hardcoded hostnames anywhere in source (invariant 6) — they arrive here.
# =============================================================================

# --- Deployment identity -----------------------------------------------------
# NEPTIQ_ENV: dev | ci | staging | prod
NEPTIQ_ENV=dev
NEPTIQ_REGION=eu-central

# --- PostgreSQL 18 -----------------------------------------------------------
# Two roles by design. The application role is NOBYPASSRLS and owns nothing;
# the migrator role owns all objects and is the ONLY role that runs DDL.
# Using one superuser role for both would make every RLS policy decorative.
DATABASE_URL=postgresql+asyncpg://neptiq_app:CHANGE_ME@localhost:5432/neptiq
DATABASE_URL_MIGRATOR=postgresql+psycopg://neptiq_migrator:CHANGE_ME@localhost:5432/neptiq

# --- Redis 7 -----------------------------------------------------------------
# EPHEMERAL ONLY: rate-limit buckets, locks, transient dedupe. Never a system
# of record — anything that must survive a restart belongs in PostgreSQL (P4).
REDIS_URL=redis://localhost:6379/0

# --- S3-compatible object storage (MinIO in dev) -----------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=neptiq-evidence
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# --- Egress proxy ------------------------------------------------------------
# The ONLY route from this system to the public internet. Every outbound fetch
# passes the SSRF validator and connects to a PINNED IP. Workers must have no
# other network path (ARCHITECTURE §1, §10).
EGRESS_PROXY_URL=http://localhost:8081

# --- Secrets -----------------------------------------------------------------
# KEK_BASE64: 32 raw bytes, base64-encoded (AES-256-GCM envelope master key).
# Lives OUTSIDE the database — storing the KEK beside the ciphertext it wraps
# defeats the entire envelope scheme. Generate with:
#     python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
KEK_BASE64=CHANGE_ME_BASE64_32_BYTES
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# --- Optional third-party credentials ---------------------------------------
# All optional. Invariant 9 requires a complete audit to be producible with
# every external provider disabled, so absence must be a supported state.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CRUX_API_KEY=

# --- Model + SERP providers (all optional; see invariant 9) -------------------
LLM_PROVIDER_PRIMARY=
LLM_PROVIDER_SECONDARY=
LLM_LOCAL_BASE_URL=http://localhost:8000/v1
SERP_PROVIDER_PRIMARY=
SERP_PROVIDER_SECONDARY=

# --- Observability -----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Sentry: request-body capture MUST stay off in prod (bodies carry tenant data).
SENTRY_DSN=

# --- Public hostnames (invariant 6: never hardcoded in source) ---------------
NEPTIQ_PUBLIC_HOST=neptiq.localhost
NEPTIQ_APP_URL=http://app.neptiq.localhost:3000
NEPTIQ_API_URL=http://api.neptiq.localhost:8080
# Published at this URL: who NeptiqBot is, what it fetches, how to block it (P13).
NEPTIQ_BOT_INFO_URL=http://neptiq.localhost/bot

# NEPTIQ_EVIDENCE_HOST must be a separate REGISTRABLE domain, not a subdomain
# of NEPTIQ_PUBLIC_HOST. Archived third-party HTML is served from here, and it
# is hostile by assumption (P6). A subdomain shares cookie scope with the app,
# so stored XSS in an archived page would reach session cookies. Startup
# asserts this via Settings.assert_evidence_domain_separate().
NEPTIQ_EVIDENCE_HOST=neptiq-evidence.localhost

# --- Crawl and cost budgets (P9: cost is first-class) ------------------------
CRAWL_MAX_URLS_DEFAULT=25000
CRAWL_MAX_URLS_CEILING=50000
RENDER_BUDGET_DEFAULT=500
LLM_BUDGET_CENTS_PER_AUDIT=300
